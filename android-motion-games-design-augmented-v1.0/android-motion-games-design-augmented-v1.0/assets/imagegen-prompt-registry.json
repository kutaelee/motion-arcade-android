{
  "schemaVersion": 1,
  "policy": {
    "generationMethod": "IMAGEGEN_SKILL",
    "skillPath": "skills/imagegen-asset-production/SKILL.md",
    "oneOffPromptsForbidden": true,
    "externalArtMixingForbidden": true,
    "manualMasterPaintingForbidden": true,
    "uiTextInImagesForbidden": true,
    "substantiveEditsRequireImageGenRevision": true,
    "approvedStyleProfiles": [
      "common-hub-v1",
      "fishing-v1",
      "boxing-v1",
      "monster-v1"
    ]
  },
  "templates": [
    {
      "templateId": "anchor-board-v1",
      "purpose": "게임 또는 공통 허브의 시각 DNA를 잠그는 reference board",
      "requiredVariables": [
        "styleProfileId",
        "scopeSummary",
        "subjects",
        "composition"
      ],
      "promptPattern": "Create an original 2D mobile arcade cartoon style anchor board for {{scopeSummary}}. Apply the entire locked style profile {{styleProfileId}} without deviation. Show {{subjects}} in {{composition}}. Keep silhouette, outline weight, palette, lighting direction, proportions, projection, and material language internally consistent. No text, letters, numbers, logos, watermarks, copyrighted characters, artist imitation, photorealism, or external asset collage."
    },
    {
      "templateId": "layered-character-v1",
      "purpose": "동일 캐릭터의 정적 레이어 파츠와 기준 pose",
      "requiredVariables": [
        "styleProfileId",
        "characterName",
        "identityTraits",
        "view",
        "parts"
      ],
      "promptPattern": "Create an original layered 2D arcade cartoon character asset for {{characterName}}, using locked style profile {{styleProfileId}} and approved reference images. Preserve these immutable identity traits: {{identityTraits}}. View: {{view}}. Separate visual parts for {{parts}} with clean overlap for runtime pivot animation. Transparent background, centered. No text, no logo, no watermark, no extra limbs, no external references, no artist imitation."
    },
    {
      "templateId": "side-background-v1",
      "purpose": "게임 필드 배경 레이어",
      "requiredVariables": [
        "styleProfileId",
        "environment",
        "camera",
        "layers",
        "safeZones"
      ],
      "promptPattern": "Create an original 2D mobile game background using locked style profile {{styleProfileId}}. Environment: {{environment}}. Camera/projection: {{camera}}. Produce visually separable layers for {{layers}}. Preserve quiet contrast in HUD and pose-guide safe zones: {{safeZones}}. No text, no characters unless explicitly listed, no signs with letters, no logos, no watermarks, no photorealism, no copyrighted setting imitation."
    },
    {
      "templateId": "creature-family-v1",
      "purpose": "물고기 또는 몬스터 family",
      "requiredVariables": [
        "styleProfileId",
        "family",
        "members",
        "sharedTraits",
        "distinctTraits"
      ],
      "promptPattern": "Create a coherent original 2D creature family for {{family}} using locked style profile {{styleProfileId}} and approved anchor references. Members: {{members}}. Shared traits: {{sharedTraits}}. Make each member distinct through {{distinctTraits}} while keeping outline, lighting, palette logic, proportions, projection, and rendering density consistent. Transparent background. No text, no watermark, no realistic gore, no copyrighted creature resemblance."
    },
    {
      "templateId": "fx-family-v1",
      "purpose": "공격·방어·물보라·마법 FX",
      "requiredVariables": [
        "styleProfileId",
        "effectFamily",
        "frames",
        "coverageLimit",
        "colorRules"
      ],
      "promptPattern": "Create an original 2D arcade effect family for {{effectFamily}} using locked style profile {{styleProfileId}}. Provide {{frames}} key-frame concepts or separable effect layers. Follow {{colorRules}}. Keep the opaque visual coverage below {{coverageLimit}} and preserve the center pose-guide/HUD safe zones. Transparent background. No text, no logo, no watermark, no photorealism, no external asset collage."
    },
    {
      "templateId": "icon-v1",
      "purpose": "텍스트 없는 게임/보상/상태 icon",
      "requiredVariables": [
        "styleProfileId",
        "symbol",
        "shapeLanguage",
        "safeMargin"
      ],
      "promptPattern": "Create an original 2D arcade icon for {{symbol}} using locked style profile {{styleProfileId}}. Shape language: {{shapeLanguage}}. Centered on a transparent background with {{safeMargin}} safe margin, strong silhouette at 64px, consistent outline and lighting. No text, letters, numbers, words, logos, watermarks, copyrighted symbols, or artist imitation."
    }
  ],
