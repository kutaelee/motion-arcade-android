{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.invalid/contracts/session-snapshot.schema.json",
  "title": "GameSessionSnapshot",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "sessionId",
    "gameId",
    "mode",
    "simulationTick",
    "status",
    "seed",
    "prng",
    "contentRevision",
    "state",
    "players",
    "committedRewardIds"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "sessionId": {
      "type": "string",
      "minLength": 1
    },
    "gameId": {
      "enum": [
        "FISHING",
        "BOXING",
        "MONSTER"
      ]
    },
    "mode": {
      "enum": [
        "SOLO",
        "DUAL"
      ]
    },
    "simulationTick": {
      "type": "integer",
      "minimum": 0
    },
    "status": {
      "enum": [
        "COUNTDOWN",
        "RUNNING",
        "PAUSED",
        "COMPLETED",
        "ABORTED"
      ]
    },
    "seed": {
      "type": "integer"
    },
    "prng": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "algorithmId",
        "algorithmVersion",
        "state"
      ],
      "properties": {
        "algorithmId": {
          "type": "string",
          "minLength": 1
        },
        "algorithmVersion": {
          "type": "integer",
          "minimum": 1
        },
        "state": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "integer"
          }
        }
      }
    },
    "contentRevision": {
      "type": "string",
      "minLength": 1
    },
    "pauseReason": {
      "type": [
        "string",
        "null"
      ]
    },
    "state": {
      "type": "object"
    },
    "players": {
      "type": "array",
      "minItems": 1,
      "maxItems": 2,
      "items": {
        "type": "object"
      }
    },
    "committedRewardIds": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    }
  }
}
